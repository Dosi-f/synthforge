# SynthForge Environment Configuration
# Copy to .env and fill in your values

# --- Provider API Keys ---
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
TOGETHER_API_KEY=your-together-key
HUGGINGFACE_TOKEN=hf_your_token_here

# --- Local Model Settings ---
LOCAL_MODEL_PATH=/path/to/your/local/model
VLLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# --- GPU ---
ROCR_VISIBLE_DEVICES=0
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.90

# --- Output ---
SYNTHFORGE_OUTPUT_DIR=./outputs
SYNTHFORGE_CACHE_DIR=./.cache

# --- Logging ---
SYNTHFORGE_LOG_LEVEL=INFO

# --- Rate Limits ---
SYNTHFORGE_MAX_CONCURRENT_REQUESTS=10
SYNTHFORGE_RATE_LIMIT_RPM=60
